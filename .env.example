NODE_ENV=production
# Set NODE_ENV=development locally to enable Swagger UI at /api-docs/
CONTAINER_NAME=vconvert
PORT=3000
PUBLISH_PORT=3000
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE_BYTES=2147483648
FILE_TTL_SECONDS=600
LOG_LEVEL=info
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=300000
HARDWARE_DETECTION_TIMEOUT_MS=5000
MEDIA_PROBE_TIMEOUT_MS=10000
FILE_CLEANUP_INTERVAL_MS=30000
AMD_VIDEO_GID=44
AMD_RENDER_GID=109
VAAPI_DEVICE=/dev/dri/renderD128
